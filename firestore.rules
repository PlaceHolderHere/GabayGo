rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isDemoAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isAdmin() {
      return isDemoAdmin()
        || (request.auth != null
          && exists(/databases/$(database)/documents/admin/$(request.auth.uid))
          && get(/databases/$(database)/documents/admin/$(request.auth.uid)).data.enabled == true);
    }

    function validLocation(data) {
      return data.keys().hasAll([
          'name', 'category', 'description', 'lat', 'lng',
          'startDate', 'startTime', 'endDate', 'endTime',
          'createdBy', 'createdAt'
        ])
        && data.keys().hasOnly([
          'name', 'category', 'description', 'lat', 'lng',
          'startDate', 'startTime', 'endDate', 'endTime',
          'createdBy', 'createdAt', 'status', 'officeHours', 'contactInfo', 'underReviewAt',
          'underReviewBy', 'resolvedAt', 'resolvedBy', 'hazardRadius', 'updatedAt'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.category in ['Location', 'Outage', 'Service', 'Marketplace', 'Garden', 'Event', 'Report', 'Hazard', 'Evacuation', 'Relief']
        && data.description is string
        && data.description.size() <= 1000
        && (!data.keys().hasAny(['officeHours']) || (data.officeHours is string && data.officeHours.size() <= 500))
        && (!data.keys().hasAny(['contactInfo']) || (data.contactInfo is string && data.contactInfo.size() <= 500))
        && (!data.keys().hasAny(['hazardRadius']) || ((data.hazardRadius is int || data.hazardRadius is float)
          && data.hazardRadius >= 50 && data.hazardRadius <= 50000))
        && (data.category != 'Hazard' || data.keys().hasAny(['hazardRadius']))
        && (!data.keys().hasAny(['updatedAt']) || data.updatedAt is timestamp)
        && (data.lat is int || data.lat is float)
        && data.lat >= -90
        && data.lat <= 90
        && (data.lng is int || data.lng is float)
        && data.lng >= -180
        && data.lng <= 180
        && (data.startDate == null || data.startDate is string)
        && (data.startTime == null || data.startTime is string)
        && (data.endDate == null || data.endDate is string)
        && (data.endTime == null || data.endTime is string)
        && (!data.keys().hasAny(['resolvedAt']) || data.resolvedAt == null || data.resolvedAt is timestamp)
        && (!data.keys().hasAny(['resolvedBy']) || data.resolvedBy == null || data.resolvedBy is string)
        && (!data.keys().hasAny(['underReviewAt']) || data.underReviewAt == null || data.underReviewAt is timestamp)
        && (!data.keys().hasAny(['underReviewBy']) || data.underReviewBy == null || data.underReviewBy is string)
        && (!data.keys().hasAny(['status']) || data.status == null || data.status in ['Submitted', 'Under review', 'Resolved'])
        && data.createdBy is string
        && data.createdAt is timestamp;
    }

    function validReportStatusTransition(before, after) {
      return before.get('category', '') != 'Report'
        || (
          before.get('status', 'Submitted') == 'Submitted'
          && after.get('status', '') == 'Under review'
          && after.get('underReviewAt', null) == request.time
          && after.get('underReviewBy', '') == request.auth.uid
          && after.get('resolvedAt', null) == before.get('resolvedAt', null)
          && after.get('resolvedBy', null) == before.get('resolvedBy', null)
        )
        || (
          before.get('status', 'Submitted') == 'Under review'
          && after.get('status', '') == 'Resolved'
          && after.get('resolvedAt', null) == request.time
          && after.get('resolvedBy', '') == request.auth.uid
          && after.get('underReviewAt', null) == before.get('underReviewAt', null)
          && after.get('underReviewBy', null) == before.get('underReviewBy', null)
        );
    }

    function validSchedule(data) {
      return data.keys().hasAll([
          'category', 'name', 'description', 'startDate', 'startTime', 'endDate', 'endTime', 'createdBy', 'createdAt'
        ])
        && data.keys().hasOnly([
          'category', 'name', 'description', 'startDate', 'startTime', 'endDate', 'endTime', 'createdBy', 'createdAt'
        ])
        && data.category == 'Schedule'
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.description is string
        && data.description.size() <= 1000
        && data.startDate is string
        && data.startDate.size() == 10
        && data.startTime is string
        && data.startTime.size() <= 5
        && data.endDate is string
        && data.endDate.size() == 10
        && data.endTime is string
        && data.endTime.size() <= 5
        && data.createdBy is string
        && data.createdAt is timestamp;
    }

    match /admin/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /Locations/{locationId} {
      allow read: if true;
      allow create: if request.auth != null
        && validLocation(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && (request.resource.data.category != 'Hazard'
          || request.resource.data.get('updatedAt', null) == request.time)
        && (request.resource.data.category != 'Report'
          || (request.resource.data.status == 'Submitted'
            && request.resource.data.underReviewAt == null
            && request.resource.data.underReviewBy == null
            && request.resource.data.resolvedAt == null
            && request.resource.data.resolvedBy == null))
        && (isAdmin() || request.resource.data.category == 'Report');
      allow update: if isAdmin()
        && validLocation(request.resource.data)
        && request.resource.data.category == resource.data.category
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && (resource.data.category != 'Hazard'
          || request.resource.data.get('updatedAt', null) == request.time)
        && validReportStatusTransition(resource.data, request.resource.data);
      allow delete: if isAdmin();
    }

    match /Schedules/{scheduleId} {
      allow read: if true;
      allow create: if request.auth != null
        && isAdmin()
        && validSchedule(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if request.auth != null
        && isAdmin()
        && validSchedule(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if request.auth != null
        && (isAdmin() || request.auth.uid == resource.data.createdBy);
    }

    function validCustomMarketplaceLocation(location) {
      return location is map
        && location.keys().hasAll(['name', 'lat', 'lng'])
        && location.keys().hasOnly(['name', 'lat', 'lng'])
        && location.name == 'Custom map pin'
        && (location.lat is int || location.lat is float)
        && location.lat >= 7.0325707
        && location.lat <= 7.0526288
        && (location.lng is int || location.lng is float)
        && location.lng >= 125.523891
        && location.lng <= 125.542271;
    }

    function validMarketplaceListing(data) {
      return data.keys().hasAll([
          'title', 'category', 'price', 'locationId', 'hours', 'offering', 'contactMethod', 'createdBy', 'createdAt'
        ])
        && data.keys().hasOnly([
          'title', 'category', 'price', 'locationId', 'hours', 'offering', 'contactMethod', 'createdBy', 'createdAt',
          'createdByName', 'approvalStatus', 'reviewedAt', 'reviewedBy', 'active', 'customLocation'
        ])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 100
        && data.category in ['Food', 'Produce', 'Retail', 'Crafts', 'Services', 'Other']
        && data.price is string
        && data.price.size() > 0
        && data.price.size() <= 100
        && data.locationId is string
        && (
          (data.locationId.size() > 0
            && !data.keys().hasAny(['customLocation'])
            && exists(/databases/$(database)/documents/Locations/$(data.locationId))
            && get(/databases/$(database)/documents/Locations/$(data.locationId)).data.category == 'Marketplace')
          || (data.locationId == ''
            && data.keys().hasAny(['customLocation'])
            && validCustomMarketplaceLocation(data.customLocation))
        )
        && data.hours is string
        && data.hours.size() > 0
        && data.hours.size() <= 200
        && data.offering is string
        && data.offering.size() > 0
        && data.offering.size() <= 1000
        && data.contactMethod is string
        && data.contactMethod.size() > 0
        && data.contactMethod.size() <= 300
        && data.createdBy is string
        && data.createdAt is timestamp
        && (!data.keys().hasAny(['createdByName']) || (data.createdByName is string && data.createdByName.size() > 0 && data.createdByName.size() <= 120))
        && (!data.keys().hasAny(['approvalStatus']) || data.approvalStatus in ['underReview', 'approved', 'denied'])
        && (!data.keys().hasAny(['reviewedAt']) || data.reviewedAt == null || data.reviewedAt is timestamp)
        && (!data.keys().hasAny(['reviewedBy']) || data.reviewedBy == null || data.reviewedBy is string)
        && (!data.keys().hasAny(['active']) || data.active is bool);
    }

    match /MarketplaceListings/{listingId} {
      allow read: if true;
      allow create: if request.auth != null
        && validMarketplaceListing(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByName is string
        && request.resource.data.createdByName.size() > 0
        && request.resource.data.createdByName.size() <= 120
        && request.resource.data.createdAt == request.time
        && request.resource.data.approvalStatus == 'underReview'
        && request.resource.data.active == true;
      allow delete: if request.auth != null && resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null
        && validMarketplaceListing(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approvalStatus', 'reviewedAt', 'reviewedBy'])
        && isAdmin()
        && request.resource.data.approvalStatus in ['approved', 'denied']
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.reviewedBy == request.auth.uid
        || (request.auth != null
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active'])
        && ((resource.data.get('active', true) == true && request.resource.data.active == false)
          || (resource.data.get('active', false) == false
            && request.resource.data.active == true)))
        || (request.auth != null
          && resource.data.createdBy == request.auth.uid
          && request.resource.data.get('createdByName', null) == resource.data.get('createdByName', null)
          && request.resource.data.get('active', true) == resource.data.get('active', true)
          && request.resource.data.approvalStatus == 'underReview'
          && request.resource.data.reviewedAt == null
          && request.resource.data.reviewedBy == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title', 'category', 'price', 'locationId', 'hours', 'offering', 'contactMethod',
            'approvalStatus', 'reviewedAt', 'reviewedBy', 'customLocation'
          ]));
    }

    function validMarketplaceOrder(data) {
      return data.keys().hasAll(['listingId', 'listingTitle', 'price', 'buyerId', 'buyerName', 'sellerId', 'sellerName', 'status', 'createdAt'])
        && data.keys().hasOnly(['listingId', 'listingTitle', 'price', 'buyerId', 'buyerName', 'sellerId', 'sellerName', 'status', 'createdAt', 'respondedAt'])
        && data.listingId is string
        && data.listingTitle is string
        && data.price is string
        && data.buyerId is string
        && data.buyerName is string
        && data.buyerName.size() > 0
        && data.buyerName.size() <= 120
        && data.sellerId is string
        && data.sellerName is string
        && data.sellerName.size() > 0
        && data.sellerName.size() <= 120
        && data.buyerId != data.sellerId
        && data.status in ['pending', 'accepted', 'rejected']
        && data.createdAt is timestamp
        && (!data.keys().hasAny(['respondedAt']) || data.respondedAt == null || data.respondedAt is timestamp);
    }

    match /MarketplaceOrders/{orderId} {
      allow read: if request.auth != null
        && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid);
      allow create: if request.auth != null
        && validMarketplaceOrder(request.resource.data)
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/MarketplaceListings/$(request.resource.data.listingId))
        && get(/databases/$(database)/documents/MarketplaceListings/$(request.resource.data.listingId)).data.createdBy == request.resource.data.sellerId
        && get(/databases/$(database)/documents/MarketplaceListings/$(request.resource.data.listingId)).data.approvalStatus == 'approved'
        && get(/databases/$(database)/documents/MarketplaceListings/$(request.resource.data.listingId)).data.get('active', true) == true
        && get(/databases/$(database)/documents/MarketplaceListings/$(request.resource.data.listingId)).data.title == request.resource.data.listingTitle
        && get(/databases/$(database)/documents/MarketplaceListings/$(request.resource.data.listingId)).data.price == request.resource.data.price;
      allow update: if request.auth != null
        && validMarketplaceOrder(request.resource.data)
        && resource.data.sellerId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status in ['accepted', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
        && request.resource.data.respondedAt == request.time;
      allow delete: if request.auth != null
        && resource.data.buyerId == request.auth.uid
        && resource.data.status in ['pending', 'rejected'];
    }
  }
}