rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admin/$(request.auth.uid))
        && get(/databases/$(database)/documents/admin/$(request.auth.uid)).data.enabled == true;
    }

    function validLocation(data) {
      return data.keys().hasAll([
          'name', 'category', 'description', 'lat', 'lng',
          'startDate', 'startTime', 'endDate', 'endTime',
          'createdBy', 'createdAt'
        ])
        && data.keys().hasOnly([
          'name', 'category', 'description', 'lat', 'lng',
          'startDate', 'startTime', 'endDate', 'endTime',
          'createdBy', 'createdAt', 'status', 'officeHours', 'contactInfo', 'underReviewAt',
          'underReviewBy', 'resolvedAt', 'resolvedBy', 'hazardRadius', 'updatedAt'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.category in ['Location', 'Outage', 'Service', 'Marketplace', 'Report', 'Hazard']
        && data.description is string
        && data.description.size() <= 1000
        && (!data.keys().hasAny(['officeHours']) || (data.officeHours is string && data.officeHours.size() <= 500))
        && (!data.keys().hasAny(['contactInfo']) || (data.contactInfo is string && data.contactInfo.size() <= 500))
        && (!data.keys().hasAny(['hazardRadius']) || ((data.hazardRadius is int || data.hazardRadius is float)
          && data.hazardRadius >= 50 && data.hazardRadius <= 50000))
        && (data.category != 'Hazard' || data.keys().hasAny(['hazardRadius']))
        && (!data.keys().hasAny(['updatedAt']) || data.updatedAt is timestamp)
        && (data.lat is int || data.lat is float)
        && data.lat >= -90
        && data.lat <= 90
        && (data.lng is int || data.lng is float)
        && data.lng >= -180
        && data.lng <= 180
        && (data.startDate == null || data.startDate is string)
        && (data.startTime == null || data.startTime is string)
        && (data.endDate == null || data.endDate is string)
        && (data.endTime == null || data.endTime is string)
        && (!data.keys().hasAny(['resolvedAt']) || data.resolvedAt == null || data.resolvedAt is timestamp)
        && (!data.keys().hasAny(['resolvedBy']) || data.resolvedBy == null || data.resolvedBy is string)
        && (!data.keys().hasAny(['underReviewAt']) || data.underReviewAt == null || data.underReviewAt is timestamp)
        && (!data.keys().hasAny(['underReviewBy']) || data.underReviewBy == null || data.underReviewBy is string)
        && (!data.keys().hasAny(['status']) || data.status == null || data.status in ['Submitted', 'Under review', 'Resolved'])
        && data.createdBy is string
        && data.createdAt is timestamp;
    }

    function validReportStatusTransition(before, after) {
      return before.get('category', '') != 'Report'
        || (
          before.get('status', 'Submitted') == 'Submitted'
          && after.get('status', '') == 'Under review'
          && after.get('underReviewAt', null) == request.time
          && after.get('underReviewBy', '') == request.auth.uid
          && after.get('resolvedAt', null) == before.get('resolvedAt', null)
          && after.get('resolvedBy', null) == before.get('resolvedBy', null)
        )
        || (
          before.get('status', 'Submitted') == 'Under review'
          && after.get('status', '') == 'Resolved'
          && after.get('resolvedAt', null) == request.time
          && after.get('resolvedBy', '') == request.auth.uid
          && after.get('underReviewAt', null) == before.get('underReviewAt', null)
          && after.get('underReviewBy', null) == before.get('underReviewBy', null)
        );
    }

    match /admin/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /Locations/{locationId} {
      allow read: if true;
      allow create: if request.auth != null
        && validLocation(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && (request.resource.data.category != 'Hazard'
          || request.resource.data.get('updatedAt', null) == request.time)
        && (request.resource.data.category != 'Report'
          || (request.resource.data.status == 'Submitted'
            && request.resource.data.underReviewAt == null
            && request.resource.data.underReviewBy == null
            && request.resource.data.resolvedAt == null
            && request.resource.data.resolvedBy == null))
        && (isAdmin() || request.resource.data.category == 'Report');
      allow update: if isAdmin()
        && validLocation(request.resource.data)
        && request.resource.data.category == resource.data.category
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && (resource.data.category != 'Hazard'
          || request.resource.data.get('updatedAt', null) == request.time)
        && validReportStatusTransition(resource.data, request.resource.data);
      allow delete: if isAdmin();
    }

    function validMarketplaceListing(data) {
      return data.keys().hasAll([
          'title', 'category', 'price', 'locationId', 'hours', 'offering', 'contactMethod', 'createdBy', 'createdAt'
        ])
        && data.keys().hasOnly([
          'title', 'category', 'price', 'locationId', 'hours', 'offering', 'contactMethod', 'createdBy', 'createdAt'
        ])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 100
        && data.category in ['Food', 'Produce', 'Retail', 'Crafts', 'Services', 'Other']
        && data.price is string
        && data.price.size() > 0
        && data.price.size() <= 100
        && data.locationId is string
        && exists(/databases/$(database)/documents/Locations/$(data.locationId))
        && get(/databases/$(database)/documents/Locations/$(data.locationId)).data.category == 'Marketplace'
        && data.hours is string
        && data.hours.size() > 0
        && data.hours.size() <= 200
        && data.offering is string
        && data.offering.size() > 0
        && data.offering.size() <= 1000
        && data.contactMethod is string
        && data.contactMethod.size() > 0
        && data.contactMethod.size() <= 300
        && data.createdBy is string
        && data.createdAt is timestamp;
    }

    match /MarketplaceListings/{listingId} {
      allow read: if true;
      allow create: if request.auth != null
        && validMarketplaceListing(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow delete: if request.auth != null && resource.data.createdBy == request.auth.uid;
      allow update: if false;
    }
  }
}